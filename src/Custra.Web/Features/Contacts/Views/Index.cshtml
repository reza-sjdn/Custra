@model ContactListViewModel

@{
    ViewData["Title"] = "Contacts";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Contacts</h1>
            <p class="text-muted mb-0">
                Customer contacts
            </p>
        </div>

        <a asp-action="Create"
           asp-route-customerId="@Model.CustomerId"
           class="btn btn-primary">
            Create Contact
        </a>
    </div>

    <form asp-action="Index"
          method="get"
          class="mb-4">

        <input type="hidden"
               name="customerId"
               value="@Model.CustomerId" />

        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Search contacts..." />

            <button type="submit"
                    class="btn btn-outline-secondary">
                Search
            </button>
        </div>
    </form>

    @if (Model.Contacts.Count == 0)
    {
        <div class="alert alert-info">
            No contacts found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Job Title</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var contact in Model.Contacts)
                    {
                        <tr>
                            <td>
                                @contact.FullName
                            </td>

                            <td>
                                @contact.JobTitle
                            </td>

                            <td>
                                @contact.Email
                            </td>

                            <td>
                                @contact.Phone
                            </td>

                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@contact.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination">

                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-customerId="@Model.CustomerId"
                               asp-route-search="@Model.Search"
                               asp-route-page="@(Model.Page - 1)">
                                Previous
                            </a>
                        </li>
                    }

                    <li class="page-item active">
                        <span class="page-link">
                            @Model.Page
                        </span>
                    </li>

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-customerId="@Model.CustomerId"
                               asp-route-search="@Model.Search"
                               asp-route-page="@(Model.Page + 1)">
                                Next
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        }
    }
</div>