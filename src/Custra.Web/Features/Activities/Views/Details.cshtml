@model Custra.Web.Features.Activities.ViewModels.ActivityViewModel

@{
    ViewData["Title"] = "Activity Details";

    var statusClass = Model.Status switch
    {
        Custra.Domain.Activities.ActivityStatus.Completed => "bg-success",
        Custra.Domain.Activities.ActivityStatus.Cancelled => "bg-secondary",
        _ => "bg-primary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Activity Details</h1>
        <p class="text-muted mb-0">@Model.Subject</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Activities
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Activity Information</h5>
    </div>

    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @statusClass">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">
                @(Model.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
            </dd>

            <dt class="col-sm-3">Completed At</dt>
            <dd class="col-sm-9">
                @(Model.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">
                @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </dd>

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">
                @Model.OwnerName
            </dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span class="text-muted">No description</span>
                }
                else
                {
                    @Model.Description
                }
            </dd>

        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Related Records</h5>
    </div>

    <div class="card-body">
        <dl class="row mb-0">

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">
                @if (Model.CustomerId.HasValue)
                {
                    <a asp-controller="Customers"
                       asp-action="Details"
                       asp-route-id="@Model.CustomerId.Value">
                        @Model.CustomerName
                    </a>
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>

            <dt class="col-sm-3">Contact</dt>
            <dd class="col-sm-9">
                @if (Model.ContactId.HasValue)
                {
                    <span>@Model.ContactName</span>
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>

            <dt class="col-sm-3">Lead</dt>
            <dd class="col-sm-9">
                @if (Model.LeadId.HasValue)
                {
                    <span>@Model.LeadName</span>
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>

            <dt class="col-sm-3">Opportunity</dt>
            <dd class="col-sm-9">
                @if (Model.OpportunityId.HasValue)
                {
                    <span>@Model.OpportunityTitle</span>
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>

        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Actions</h5>
    </div>

    <div class="card-body d-flex gap-2 flex-wrap">

        @if (Model.Status == Custra.Domain.Activities.ActivityStatus.Planned)
        {
            <form asp-action="Complete"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit"
                        class="btn btn-success">
                    Complete
                </button>
            </form>

            <form asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit"
                        class="btn btn-warning">
                    Cancel Activity
                </button>
            </form>
        }

        @if (Model.Status == Custra.Domain.Activities.ActivityStatus.Cancelled)
        {
            <form asp-action="Reopen"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit"
                        class="btn btn-primary">
                    Reopen
                </button>
            </form>
        }

        @if (Model.Status == Custra.Domain.Activities.ActivityStatus.Completed)
        {
            <form asp-action="Reopen"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit"
                        class="btn btn-primary">
                    Reopen
                </button>
            </form>
        }

        <a asp-action="DeleteConfirmation"
           asp-route-id="@Model.Id"
           class="btn btn-outline-danger">
            Delete
        </a>

    </div>
</div>
