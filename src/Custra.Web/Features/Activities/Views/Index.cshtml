@model ActivityListViewModel

@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Activities</h1>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Create Activity
    </a>
</div>

<form asp-action="Index" method="get" class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Search" class="form-label">Search</label>
                <input asp-for="Search"
                       class="form-control"
                       placeholder="Search subject or description..." />
            </div>

            <div class="col-md-2">
                <label asp-for="Type" class="form-label">Type</label>
                <select asp-for="Type"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<Custra.Domain.Activities.ActivityType>()">
                    <option value="">All</option>
                </select>
            </div>

            <div class="col-md-2">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<Custra.Domain.Activities.ActivityStatus>()">
                    <option value="">All</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    Filter
                </button>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    Clear
                </a>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Activities.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No activities found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Owner</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var activity in Model.Activities)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@activity.Id"
                                       class="text-decoration-none fw-semibold">
                                        @activity.Subject
                                    </a>
                                </td>

                                <td>
                                    @activity.Type
                                </td>

                                <td>
                                    <span class="badge
                                        @(activity.Status == Custra.Domain.Activities.ActivityStatus.Completed
                                            ? "bg-success"
                                            : activity.Status == Custra.Domain.Activities.ActivityStatus.Cancelled
                                                ? "bg-secondary"
                                                : "bg-primary")">
                                        @activity.Status
                                    </span>
                                </td>

                                <td>
                                    @(activity.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                </td>

                                <td>
                                    @activity.OwnerName
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@activity.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@activity.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-Search="@Model.Search"
                   asp-route-Status="@Model.Status"
                   asp-route-Type="@Model.Type"
                   asp-route-Page="@(Model.Page - 1)"
                   asp-route-PageSize="@Model.PageSize">
                    Previous
                </a>
            </li>

            @for (var pageNum = 1; pageNum <= Model.TotalPages; pageNum++)
            {
                <li class="page-item @(pageNum == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Search"
                       asp-route-Status="@Model.Status"
                       asp-route-Type="@Model.Type"
                       asp-route-Page="@pageNum"
                       asp-route-PageSize="@Model.PageSize">
                        @pageNum
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-Search="@Model.Search"
                   asp-route-Status="@Model.Status"
                   asp-route-Type="@Model.Type"
                   asp-route-Page="@(Model.Page + 1)"
                   asp-route-PageSize="@Model.PageSize">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}