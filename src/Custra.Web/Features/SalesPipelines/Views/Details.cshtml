@model SalesPipelineViewModel

@{
    ViewData["Title"] = "Sales Pipeline Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.Name</h2>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this pipeline?');">

            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Stages</h4>

    <a asp-action="CreateStage"
       asp-route-pipelineId="@Model.Id"
       class="btn btn-success">
        Add Stage
    </a>
</div>

@if (!Model.Stages.Any())
{
    <div class="alert alert-info">
        This pipeline has no stages.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Order</th>
                <th>Name</th>
                <th>Probability</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var stage in Model.Stages.OrderBy(x => x.Order))
            {
                <tr>
                    <td>@stage.Order</td>

                    <td>@stage.Name</td>

                    <td>
                        @(stage.Probability.HasValue
                                        ? $"{stage.Probability.Value:N0}%"
                                        : "-")
                    </td>

                    <td class="text-end">
                        <a asp-action="EditStage"
                           asp-route-id="@stage.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                        <form asp-action="DeleteStage"
                              asp-route-id="@stage.Id"
                              asp-route-pipelineId="@Model.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this stage?');">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back to Pipelines
</a>