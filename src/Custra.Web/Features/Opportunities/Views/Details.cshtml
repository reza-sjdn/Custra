@using Custra.Domain.Opportunities
@model OpportunityViewModel

@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Opportunity Details</h2>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this opportunity?');">

            <button type="submit" class="btn btn-danger">
                Delete
            </button>
        </form>
    </div>
</div>

<dl class="row">

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.CustomerId</dd>

    <dt class="col-sm-3">Contact</dt>
    <dd class="col-sm-9">@(Model.ContactId?.ToString() ?? "-")</dd>

    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.OwnerUserId</dd>

    <dt class="col-sm-3">Pipeline</dt>
    <dd class="col-sm-9">@Model.SalesPipelineId</dd>

    <dt class="col-sm-3">Stage</dt>
    <dd class="col-sm-9">@Model.SalesPipelineStageId</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Estimated Value</dt>
    <dd class="col-sm-9">
        @(Model.EstimatedValue?.ToString("N2") ?? "-")
    </dd>

    <dt class="col-sm-3">Expected Close Date</dt>
    <dd class="col-sm-9">
        @(Model.ExpectedCloseDate?.ToString("yyyy-MM-dd") ?? "-")
    </dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">
        @(Model.Description ?? "-")
    </dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">
        @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
    </dd>

</dl>

<hr />

<div class="mb-3">
    <h4>Opportunity Status</h4>

    @if (Model.Status == OpportunityStatus.Open)
    {
        <form asp-action="MarkWon"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            <button type="submit" class="btn btn-success">
                Mark Won
            </button>
        </form>

        <form asp-action="MarkLost"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            <button type="submit" class="btn btn-danger">
                Mark Lost
            </button>
        </form>
    }
    else
    {
        <form asp-action="Reopen"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            <button type="submit" class="btn btn-warning">
                Reopen
            </button>
        </form>
    }
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">
        Back to Opportunities
    </a>
</div>