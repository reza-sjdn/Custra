@model TaskItemViewModel

@{
    ViewData["Title"] = "Delete Task";
}

<h1 class="mb-4">Delete Task</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this task? This action cannot be undone.
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5>@Model.Title</h5>
        <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
        <p class="mb-1"><strong>Priority:</strong> @Model.Priority</p>
        <p class="mb-0"><strong>Owner:</strong> @Model.OwnerName</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Details" asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">Cancel</a>
</form>