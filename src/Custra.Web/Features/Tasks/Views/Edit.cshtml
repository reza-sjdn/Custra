@model EditTaskItemViewModel

@{
    ViewData["Title"] = "Edit Task";
}

<h1 class="mb-4">Edit Task</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ActivityId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Priority" class="form-label">Priority</label>
            <select asp-for="Priority"
                    asp-items="Html.GetEnumSelectList<Custra.Domain.Tasks.TaskItemPriority>()"
                    class="form-select"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="OwnerUserId" class="form-label">Owner</label>
            <select asp-for="OwnerUserId" asp-items="Model.Owners" class="form-select">
                <option value="">Select owner</option>
            </select>
            <span asp-validation-for="OwnerUserId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="DueDate" class="form-label">Due date</label>
            <input asp-for="DueDate" type="datetime-local" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="CustomerId" class="form-label">Customer</label>
            <select asp-for="CustomerId" asp-items="Model.Customers"
                    class="form-select" id="customerSelect">
                <option value="">No customer</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="ContactId" class="form-label">Contact</label>
            <select asp-for="ContactId" asp-items="Model.Contacts"
                    class="form-select" id="contactSelect">
                <option value="">No contact</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="LeadId" class="form-label">Lead</label>
            <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
                <option value="">No lead</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="OpportunityId" class="form-label">Opportunity</label>
            <select asp-for="OpportunityId" asp-items="Model.Opportunities"
                    class="form-select">
                <option value="">No opportunity</option>
            </select>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const customerSelect = document.getElementById("customerSelect");
            const contactSelect = document.getElementById("contactSelect");
            const contactsUrl = '@Url.Action("GetContacts", "Tasks")';

            customerSelect.addEventListener("change", async () => {
                contactSelect.replaceChildren(new Option("No contact", ""));

                if (!customerSelect.value) {
                    return;
                }

                contactSelect.disabled = true;

                try {
                    const url = new URL(contactsUrl, window.location.origin);
                    url.searchParams.set("customerId", customerSelect.value);

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Unable to load contacts.");
                    }

                    const contacts = await response.json();

                    for (const contact of contacts) {
                        contactSelect.add(new Option(contact.name, contact.id));
                    }
                } catch {
                    alert("Could not load contacts for the selected customer.");
                } finally {
                    contactSelect.disabled = false;
                }
            });
        })();
    </script>
}